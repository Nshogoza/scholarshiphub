# Copy to .env for running the backend standalone (outside docker-compose),
# e.g. from an IDE against a locally-installed Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scholarshiphub
DB_USERNAME=postgres
DB_PASSWORD=Narasha

JWT_SECRET=CHANGE_ME_dev_only_secret_key_at_least_256_bits_long_please_replace_in_prod
JWT_ACCESS_TOKEN_EXP_MIN=15
JWT_REFRESH_TOKEN_EXP_DAYS=7

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
EMAIL_VERIFICATION_EXP_HOURS=24
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_RESET_EXP_MIN=30

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

UPLOAD_DIR=./uploads
COOKIE_SECURE=false
COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
