# ---------------------------------------------------------------------------
# Copy this file to .env and adjust values for your environment.
# docker-compose.yml reads these to configure Postgres, the backend, and the
# frontend build. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=scholarshiphub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Narasha
POSTGRES_PORT=5432

# --- Backend ---
SERVER_PORT=8080
DB_HOST=postgres
DB_PORT=5432
DB_NAME=scholarshiphub
DB_USERNAME=postgres
DB_PASSWORD=Narasha

# HS256 signing key for JWT access tokens. Generate a strong random value for
# any real deployment, e.g.: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_dev_only_secret_key_at_least_256_bits_long_please_replace_in_prod
JWT_ACCESS_TOKEN_EXP_MIN=15
JWT_REFRESH_TOKEN_EXP_DAYS=7

LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
EMAIL_VERIFICATION_EXP_HOURS=24
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_RESET_EXP_MIN=30

# Local dev/demo mail sink (MailHog); point at a real SMTP provider in prod.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

UPLOAD_DIR=/app/uploads

# Set to true and provide a domain when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Frontend (build-time) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
